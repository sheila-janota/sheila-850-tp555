   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline\n",
    "\n",
    "M = 10000\n",
    "\n",
    "x = np.random.uniform(size=M)\n",
    "y = np.random.uniform(size=M)\n",
    "z = x+y\n",
    "plt.title('Histograma')\n",
    "plt.hist(z, bins=100, density=True , color='b')\n",
    "plt.savefig('Histograma.png') # salva figura em arquivo png"
   ]
